{
  "name": "@chtc/web-components",
  "version": "2.0.2",
  "homepage": "https://path-cc.io/web-components/",
  "repository": {
    "type": "git",
    "url": "https://github.com/CHTC/web-components"
  },
  "description": "CHTC Web Components",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./charts": {
      "types": "./charts/index.d.ts",
      "default": "./charts/index.js"
    },
    "./content": {
      "types": "./content/index.d.ts",
      "default": "./content/index.js"
    },
    "./github": {
      "types": "./github/index.d.ts",
      "default": "./github/index.js"
    },
    "./themes": {
      "types": "./themes/index.d.ts",
      "default": "./themes/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*"
  ],
  "scripts": {
    "publish:local": "pnpm publish --access public --no-git-checks",
    "publish:increment": "pnpm version patch --no-git-tag-version && pnpm publish --access public --no-git-checks"
  },
  "sideEffects": [
    "BigNumber/*.*",
    "PieChart/*.*",
    "themes/*.*"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "colorjs.io": "^0.5.2",
    "js-yaml": "^5.4.3",
    "react-wrap-balancer": "^1.1.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "chart.js": "^4.4.0",
    "chartjs-adapter-luxon": "^1.3.0",
    "luxon": "^3.0.0",
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-chartjs-2": "^5.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-markdown": "^9.0.0",
    "rehype-raw": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@mui/icons-material": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "chartjs-adapter-luxon": {
      "optional": true
    },
    "luxon": {
      "optional": true
    },
    "react-chartjs-2": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "rehype-raw": {
      "optional": true
    }
  }
}
