{
  "name": "@chtc/web-components",
  "version": "0.0.0-50",
  "description": "PATh Web Components",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "default": "./dist/content/index.js"
    },
    "./github": {
      "types": "./dist/github/index.d.ts",
      "default": "./dist/github/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "default": "./dist/themes/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CHTC/web-components"
  },
  "scripts": {
    "test": "jest --coverage --json --outputFile=.github/tests/test-summary.json",
    "build": "tsc --build src",
    "bundle": "npm run bundle:web && npm run bundle:minimal",
    "bundle:web": "webpack --config webpack.config.js",
    "bundle:minimal": "webpack --config webpack.config.minimal.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "publish:current": "npm publish --omit=dev --access public",
    "publish:increment": "npm version prerelease --no-git-tag-version && npm publish --omit=dev --access public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "dist/BigNumber/*.*",
    "dist/PieChart/*.*",
    "dist/themes/*.*"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "colorjs.io": "^0.5.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.4.3",
    "react-wrap-balancer": "^1.1.1"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.23.3",
    "@chromatic-com/storybook": "^3.2.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/addon-onboarding": "^8.4.7",
    "@storybook/addon-themes": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/nextjs": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@types/jest": "^29.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chart.js": "^4.4.7",
    "chartjs-adapter-luxon": "^1.3.1",
    "esbuild": "^0.25.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "luxon": "^3.7.2",
    "react-chartjs-2": "^5.3.0",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "storybook": "^8.4.7",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "chart.js": "^4.4.0",
    "chartjs-adapter-luxon": "^1.3.0",
    "luxon": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-chartjs-2": "^5.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-markdown": "^9.0.0",
    "rehype-raw": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@mui/icons-material": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "chartjs-adapter-luxon": {
      "optional": true
    },
    "luxon": {
      "optional": true
    },
    "react-chartjs-2": {
      "optional": true
    },
    "react-markdown": {
      "optional": true
    },
    "rehype-raw": {
      "optional": true
    }
  }
}
